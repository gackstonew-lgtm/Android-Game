<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GameTheme" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="GameTheme.Fullscreen" parent="GameTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" xmlns:tools="http://schemas.android.com/tools" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
